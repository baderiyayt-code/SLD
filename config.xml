<?xml version='1.0' encoding='utf-8'?>
<widget id="in.discom.feeder.survey" version="2.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>DISCOM Survey Pro</name>
    <description>DISCOM Feeder Survey Offline App with Smart Sync</description>
    <author email="it@discom.in">DISCOM IT Team</author>
    <content src="index.html" />
    
    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="33" />

    <!-- Storage & Network Plugins -->
    <plugin name="cordova-plugin-file" spec="^8.0.0" />
    <plugin name="cordova-plugin-geolocation" spec="^5.0.0" />
    <plugin name="cordova-plugin-network-information" spec="^3.0.0" /> <!-- For Auto Sync -->
    <plugin name="cordova-sqlite-storage" spec="^6.0.0" /> <!-- Advanced DB -->
</widget>
