<?xml version='1.0' encoding='utf-8'?>
<widget id="com.discom.surveypro" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    
    <!-- App Details -->
    <name>DISCOM Pro</name>
    <description>Enterprise GIS Field Survey Application for DISCOM</description>
    <author email="support@discom.com" href="https://discom.com">
        DISCOM Dev Team
    </author>
    
    <content src="index.html" />
    
    <!-- Network & Security Settings -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />
    
    <!-- ========================================== -->
    <!-- APP LOGO / ICON CONFIGURATION              -->
    <!-- ========================================== -->
    <!-- Default Icon -->
    <icon src="res/icon.png" />
    
    <!-- Android Platform Settings -->
    <platform name="android">
        <allow-intent href="market:*" />
        
        <!-- API Level Preferences -->
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="33" />
        <preference name="AndroidXEnabled" value="true" />
        
        <!-- Android Specific Icons for all screen sizes -->
        <icon src="res/icon.png" density="ldpi" />
        <icon src="res/icon.png" density="mdpi" />
        <icon src="res/icon.png" density="hdpi" />
        <icon src="res/icon.png" density="xhdpi" />
        <icon src="res/icon.png" density="xxhdpi" />
        <icon src="res/icon.png" density="xxxhdpi" />
    </platform>
    
    <!-- iOS Platform Settings (Optional) -->
    <platform name="ios">
        <allow-intent href="itms:*" />
        <allow-intent href="itms-apps:*" />
    </platform>

    <!-- General App UI Preferences -->
    <preference name="DisallowOverscroll" value="true" />
    <preference name="Orientation" value="default" />
    <preference name="Fullscreen" value="false" />
    <preference name="ShowSplashScreenSpinner" value="false" />

</widget>
